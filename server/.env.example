# Plantilla de configuración del servidor.
# Cópiala a server/.env y completa los valores:  cp .env.example .env
# El archivo .env NO se sube a Git.

# ── Servidor Express ─────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
# development en tu computadora; production en la Raspberry Pi 5
# (en production los errores no muestran detalles internos)
NODE_ENV=production

# ── CORS: orígenes permitidos (separados por coma) ───────────
# Solo hacen falta los orígenes que NO son el mismo que la API:
# el servidor de desarrollo de Vite y, si lo usas, el acceso por IP.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── MariaDB ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tms_user
# La misma contraseña que pusiste en setup_db.sql (obligatoria)
DB_PASSWORD=
DB_NAME=tms_db
